# Copy this file to ".env" and fill in your values.  run.sh loads it automatically.
# Keep .env private (chmod 600 .env) — it holds passwords.

# ---- Gmail (IMAP) ----
# Use a Gmail APP PASSWORD (Google Account -> Security -> App passwords),
# NOT your normal Gmail password. Requires 2-Step Verification enabled.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ---- Monarch Money ----
MONARCH_EMAIL=you@example.com
MONARCH_PASSWORD=your-monarch-password
# Base32 authenticator "setup key" (e.g. JBSWY3DPEHPK3PXP). Needed only on the
# first run; after that the saved session file is reused. Leave blank if no MFA.
MONARCH_MFA_SECRET=

# ---- Optional overrides (defaults shown) ----
RECEIPT_SENDERS=receipts@aisleonekosher.com,info@evergreenkosher.com,receipts@hivediscount.com
RECEIPT_SINCE=01-May-2025
GMAIL_MAILBOX=INBOX
MONARCH_SESSION_FILE=/root/.monarch/mm_session.pickle
TRASH_ON_SUCCESS=true
